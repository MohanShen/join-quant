node_modules/
__pycache__/

# ── Secrets: never tracked, no exceptions ───────────────────────────────────
# CLAUDE.md is explicit — a cookie file is a live brokerage session.
auth/cookies.json
data/cookies.json
# Holds the remote QMT server host. CDP on a logged-in session is a full
# remote-control channel and must not be published.
config/exec.env
# Local scratch with hardcoded credentials.
test-jq-login.js
test-jq-editor.js

# ── Not repository content ──────────────────────────────────────────────────
# Separate checkouts. `git add -A .claude` once staged rq-executor as a gitlink,
# which makes clones reference a submodule that does not exist.
.claude/worktrees/
# PID files.
data/*.lock

# ── Runtime logs ────────────────────────────────────────────────────────────
# Full agent transcripts, rewritten on every fire. These are the one thing here
# that is genuinely churn rather than state: they record what a run SAID, while
# the ledgers below record what it DID, and the ledgers are what any later run
# reads. Un-ignore these if you want the transcripts in history too.
data/daily-logs/
data/autoenhance-logs/
data/autostudy-logs/
data/autoresearch-logs/

# ── Backups, not history ────────────────────────────────────────────────────
harness/normalize-*.bak
data/*.pre-uniquekey.bak

# ═══════════════════════════════════════════════════════════════════════════
# EVERYTHING ELSE IS TRACKED, on purpose (2026-09-22).
#
# This repo has been bitten three times by ignoring state that later turned out
# to be the only copy:
#   - harness/normalize-*.tsv silently regressed from ~119 rows to 18 and blocked
#     every family page from regenerating;
#   - enhance/ideas-queue.json + results.tsv were absent, so a cold start had
#     nothing to reconcile against and opened a brand-new epoch instead of
#     resuming 13 waiting families;
#   - study/<family>/findings.tsv held 4 results with no §2/§6 counterpart when
#     an API 529 killed a round — results that existed only outside git.
#
# So the ledgers, queues, manifests, findings and caches are all tracked now:
#   harness/normalize-*.tsv      study/*/findings.tsv    study/*/questions.json
#   study/*/queue.json           study/manifest.json     enhance/*.json
#   enhance/results.tsv          screen/candidates.json  screen/batches/
#   data/series/                 data/series-scan.json   data/consumption.tsv
#   data/daily-state.json        data/deferred.json      data/research-sessions/
#
# They churn, and that is the point: a diff on them is the record of what the
# pipeline did. If one becomes genuinely too large, prune it — do not ignore it.
