node_modules/
# data/ — tracked for private backup
# auth/ — tracked for private backup

# Session cookies — secrets, never track (kept on disk, ignored)
auth/cookies.json
data/cookies.json

# Local scratch / exploration scripts (contain hardcoded credentials)
test-jq-login.js
test-jq-editor.js
__pycache__/
harness/normalize-*.tsv
harness/normalize-*.bak
harness/normalize-*.rebuild.json

# Auto-enhance team idea queue — transient working state, not tracked
enhance/ideas-queue.json

# Auto-enhance team loop checkpoint — transient resume state, not tracked
enhance/loop-state.json

# Auto-study transient state (queue + findings ledger), not tracked
study/*/findings.tsv
study/*/questions.json
study/manifest.json

# Auto-enhance results ledger — transient, not tracked
enhance/results.tsv

# Execution-mode config — holds the remote server host, never track
config/exec.env

# One-time uniqueKey migration backups — safety copies, not history
data/*.pre-uniquekey.bak

# Screening working state — candidates carry fetched post bodies; batches are per-run
screen/candidates.json
screen/batches/

# Backtest-curve scan cache — a fingerprint index of every backtest the JQ account still
# holds, rebuilt for free by `series-backfill.js --scan`. The CURVES themselves
# (data/series/) stay tracked: gitignoring a ledger is what let normalize-*.tsv regress
# from ~119 rows to 18 unnoticed.
data/series-scan.json

# Local git worktrees created under .claude/ — they are separate checkouts, never content
# of this repo. `git add -A .claude` once staged rq-executor as a gitlink, which would make
# clones reference a submodule that does not exist.
.claude/worktrees/

# Daily pipeline transients. `data/daily-state.json` and `data/deferred.json` are TRACKED on
# purpose — the run log and the deferred work queue are what let tomorrow resume, and losing
# the pool would re-strand every slow-skipped strategy with no route back.
data/daily-logs/
data/*.lock
