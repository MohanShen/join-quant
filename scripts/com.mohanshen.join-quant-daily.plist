<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: the one-a-day pipeline.

  Fires scripts/daily-pipeline.sh, which picks ONE stage by queue priority
  (enhance > study > normalize > discover), spends the day's backtest budget on it, and
  records enough state to resume tomorrow.

  Starts once a day at 18:00 UTC.

  ⚠ Why two StartCalendarInterval entries for one daily run. launchd evaluates calendar
  intervals in the machine's LOCAL timezone, and this machine is America/Los_Angeles, which
  observes DST — so 18:00 UTC is 11:00 PDT in summer and 10:00 PST in winter. A single fixed
  local hour would silently drift by an hour twice a year. Both hours therefore fire, and
  scripts/daily-pipeline.sh keeps only the one where `date -u +%H` really is
  DAILY_RUN_HOUR_UTC; the other exits in milliseconds. Change the hour in ONE place
  (DAILY_RUN_HOUR_UTC) and adjust the two local hours to bracket it.

  RunAtLoad is false: with a fixed daily slot, firing on load would run at an arbitrary time.
  To run immediately by hand: `bash scripts/daily-pipeline.sh` (a manual run is never gated by
  the clock), or `FORCE=1 ...` to bypass the gate in a scheduled context.

  ⚠ Tradeoff of a single daily slot: if the CDP browser is down or the budget is already
  spent at 18:00 UTC, that day is simply missed — the wrapper exits 0 and does not retry.
  The previous 4-hourly schedule caught the first usable window instead. If missed days become
  a problem, add more hours to the array and gate on "no successful run recorded today"
  (data/daily-state.json already carries that) rather than widening the UTC gate.

  USAGE_LIMIT = 55 keeps this inside the free 60 minutes. Raise it only if you mean to spend
  credits; the existing autostudy/autoenhance plists use 240 and will compete for the same
  budget through the same shared lock.

  ⚠ This agent can RESUME the study/enhance loops but cannot cold-start them — they need a
  session pinned interactively once (scripts/auto{study,enhance}-interactive.sh). When the pin
  is missing or on another branch, the run reports BLOCKED and exits non-zero, which is why
  the error log is worth watching rather than assuming green.

  Install:  cp scripts/com.mohanshen.join-quant-daily.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/com.mohanshen.join-quant-daily.plist
  Stop:     launchctl unload ~/Library/LaunchAgents/com.mohanshen.join-quant-daily.plist
  Try once: DRY=1 bash scripts/daily-pipeline.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mohanshen.join-quant-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mshen/join-quant/scripts/daily-pipeline.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/mshen/join-quant</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/mshen/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>USAGE_LIMIT</key>
    <string>55</string>
    <key>JQ_CDP_URL</key>
    <string>http://localhost:9225</string>
    <key>DAILY_SCHEDULED</key>
    <string>1</string>
    <key>DAILY_RUN_HOUR_UTC</key>
    <string>18</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/mshen/join-quant/data/daily-logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mshen/join-quant/data/daily-logs/launchd.err.log</string>
</dict>
</plist>
