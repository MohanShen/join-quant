# Copy this file to `exec.env` (same directory) and fill in your values.
# `config/exec.env` is gitignored — the server host never gets committed.
#
# Selects WHERE the CDP Chrome that drives JoinQuant lives. See README "Execution modes".

# local  = Chrome runs on this machine (default, original behaviour)
# remote = Chrome runs on the Windows QMT server, reached over an SSH tunnel
JQ_EXEC_MODE=local

# Local port the code connects to. In remote mode this is the near end of the tunnel.
JQ_CDP_PORT=9225

# --- remote mode only ------------------------------------------------------
# SSH target for the server running Chrome (same host as the QMT-server repo).
JQ_REMOTE_SSH_HOST="administrator@<public-ip>"

# Extra ssh options — non-default key, port, etc. Use $HOME, not ~ (this value is
# passed through a variable, and bash does not tilde-expand after expansion).
JQ_REMOTE_SSH_OPTS="-i $HOME/.ssh/id_ed25519"

# Port Chrome listens on *on the server* (its --remote-debugging-port).
JQ_REMOTE_CDP_PORT=9225
